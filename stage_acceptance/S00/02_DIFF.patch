+++++++    runs = root / "manifests" / "runs"
+++++++    runs.mkdir(parents=True, exist_ok=True)
+++++++    rel = f"manifests/runs/{run_id}.json"
+++++++    (root / rel).write_text(json.dumps(manifest, indent=2, sort_keys=True), encoding="utf-8")
+++++++    return rel
