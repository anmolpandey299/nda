+++++def _identifiers(node: ast.AST) -> set[str]:
+++++    names: set[str] = set()
+++++    for child in ast.walk(node):
+++++        if isinstance(child, ast.Name):
+++++            names.add(child.id)
+++++        elif isinstance(child, ast.Attribute):
+++++            names.add(child.attr)
+++++        elif isinstance(child, ast.arg):
+++++            names.add(child.arg)
+++++    return names
