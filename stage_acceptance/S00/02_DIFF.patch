+++    root = Path(args.root).resolve()
+++    out_dir = Path(args.out).resolve() if args.out else None
+++
+++    try:
+++        import torch
+++    except ImportError as exc:
+++        print(f"S00_ENV_CAPTURE = {TBD}", file=sys.stderr)
+++        print(f"torch is not importable: {exc}", file=sys.stderr)
