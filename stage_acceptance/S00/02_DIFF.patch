+++++++++++++++
+++++++++++++++#: Actual integration, not prose mentions [AUTH: 01 §6.2, §24].
+++++++++++++++_OR = "open" + "router"
+++++++++++++++FORBIDDEN_PROVIDER = re.compile(
+++++++++++++++    r"(?i)(?:" + _OR + r"\.ai|" + _OR + r"_api_key|import\s+" + _OR + r"|from\s+" + _OR + r")"
