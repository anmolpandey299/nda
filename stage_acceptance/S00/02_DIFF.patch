+++++++@dataclass(frozen=True)
+++++++class Violation:
+++++++    invariant: str
+++++++    path: str
+++++++    reason: str
+++++++
+++++++    def render(self) -> str:
+++++++        return f"{self.invariant} {self.path} {self.reason}"
