++++++++++# --------------------------------------------------------------------------------------
++++++++++# step 7 — provenance-bound evidence verification  [AUTH: 01 §16; 02 §C6; 00 §34B.3]
++++++++++# --------------------------------------------------------------------------------------
++++++++++
++++++++++
++++++++++@dataclass(frozen=True)
++++++++++class EvidenceVerdict:
++++++++++    key: str
++++++++++    accepted: bool
++++++++++    status: str
++++++++++    reason: str = ""
