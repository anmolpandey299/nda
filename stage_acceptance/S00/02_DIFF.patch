++++++++ENVIRONMENT_LOCK_COMPONENTS: tuple[str, ...] = (
++++++++    "uv_lock_sha256",
++++++++    "docker_image_digest",
++++++++    "cuda_runtime",
++++++++    "cuda_driver",
++++++++    "torch_version",
++++++++    "torch_cuda_build",
++++++++    "python_version",
++++++++    "gpu_model",
++++++++)
