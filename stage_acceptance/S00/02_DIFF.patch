++++++++++++++    present = [p for p in FORBIDDEN_PATHS if (repo_root / p).exists()]
++++++++++++++    assert missing == [], f"required paths missing: {missing}"
++++++++++++++    assert present == [], f"forbidden paths present: {present}"
