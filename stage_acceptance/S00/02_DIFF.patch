+    assert probe["observed"]["stock_container_python"] == STOCK_PYTHON
+    assert probe["observed"]["stock_torch"] == STOCK_TORCH
+    assert probe["observed"]["docker_available_in_pod"] is False
+    assert len(probe["rejected_because"]) >= 4
+
