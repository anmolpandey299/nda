+++            "resolve on the RunPod H100 SXM image per 01 §12 steps 2-9, then rerun",
+++            file=sys.stderr,
+++        )
+++        return 1
+++    print(f"wrote {published}")
+++    print("S00_ENV_CAPTURE = COMPLETE")
+++    return 0
+++
+++
+++if __name__ == "__main__":
+++    raise SystemExit(main())
