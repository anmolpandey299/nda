+    fabricated = "0e6f16f2c8a5d419b7e3f06c9a2d5b8e4c1f7a30"
+    for path in repo_root.rglob("*"):
+        if ".git/" in path.as_posix() or ".venv" in path.parts:
+            continue
+        if path.is_file() and path.suffix in {".md", ".py", ".sh", ".json", ".txt", ".yml"}:
