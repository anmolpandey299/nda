++++++++++++
++++++++++++COPY pyproject.toml uv.lock README.md ./
++++++++++++COPY src ./src
++++++++++++# --frozen never re-resolves: a drifted lock fails the build [AUTH: 01 §12, §46].
++++++++++++RUN uv sync --frozen --extra cpu-dev --extra science --no-install-project
