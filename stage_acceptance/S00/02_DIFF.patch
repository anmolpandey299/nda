++++++++++#: Readiness evidence, exactly the plan §11 keys [AUTH: 02 §C6].
++++++++++EVIDENCE_KEYS: tuple[str, ...] = (
++++++++++    "backend_contract",
++++++++++    "synthetic_suite",
++++++++++    "cache_assertions",
++++++++++    "gpu_smoke",
++++++++++    "benchmark_1000_seq",
++++++++++)
