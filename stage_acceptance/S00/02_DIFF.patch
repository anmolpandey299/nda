++++++++++    ENVIRONMENT_LOCK_COMPONENTS,
++++++++++    RUN_ID_INPUTS,
++++++++++    RUN_MANIFEST_REQUIRED_FIELDS,
++++++++++    Violation,
++++++++++    run_all,
++++++++++)
++++++++++
++++++++++TBD = "TBD_REQUIRES_HARDWARE"
++++++++++SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
