++++++++#: including under an alias [AUTH: 02 §C2].
++++++++ROC_TOOLKIT_MODULES: tuple[str, ...] = ("sklearn.metrics",)
++++++++ROC_TOOLKIT_SYMBOLS: frozenset[str] = frozenset(
++++++++    {"roc_curve", "roc_auc_score", "det_curve", "precision_recall_curve", "RocCurveDisplay"}
