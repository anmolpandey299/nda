++++++++++++++
++++++++++++++def py_files(root: Path, sub: str) -> list[Path]:
++++++++++++++    base = root / sub
++++++++++++++    if not base.is_dir():
++++++++++++++        return []
++++++++++++++    return sorted(p for p in base.rglob("*.py") if ".venv" not in p.parts)
