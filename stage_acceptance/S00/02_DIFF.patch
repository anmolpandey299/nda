+++++++    out: list[Violation] = []
+++++++    pat = re.compile("P0_PRE" + "_READY" + r'"?\s*[:=]\s*[Tt]rue')
+++++++    for f in list(py_files(root, "src")) + list(py_files(root, "scripts")):
+++++++        rel = f.relative_to(root).as_posix()
+++++++        if rel == "scripts/preflight.py":
