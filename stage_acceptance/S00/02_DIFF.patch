+++++++++++    text = reg.read_text(encoding="utf-8")
+++++++++++    body = text.split("## Granted exceptions", 1)[-1] if "## Granted exceptions" in text else ""
+++++++++++    return set(re.findall(r"src/[\w/]+\.py", body))
