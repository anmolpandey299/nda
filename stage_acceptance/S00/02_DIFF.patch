+++    payload = json.dumps(finalised, indent=2, sort_keys=True) + "\n"
+++    handle, temporary = tempfile.mkstemp(dir=str(directory), suffix=".tmp")
+++    try:
+++        with os.fdopen(handle, "w", encoding="utf-8") as stream:
+++            stream.write(payload)
