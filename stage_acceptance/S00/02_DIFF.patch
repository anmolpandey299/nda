++#: Distribution names that ship the CUDA runtime, newest naming first [AUTH: 01 §12].
++CUDA_RUNTIME_DISTRIBUTIONS: tuple[str, ...] = (
++    "nvidia-cuda-runtime",
++    "nvidia-cuda-runtime-cu13",
++    "nvidia-cuda-runtime-cu12",
++)
