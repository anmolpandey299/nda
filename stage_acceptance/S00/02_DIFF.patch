+++        out += [
+++            Violation("I2", p.relative_to(root).as_posix(), "config references a notebook")
+++            for p in cfg.rglob("*")
+++            if p.is_file()
+++            and p.suffix in {".yaml", ".yml", ".json", ".toml"}
+++            and ".ipynb" in p.read_text(encoding="utf-8", errors="ignore")
