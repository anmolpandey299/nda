++++++++#: Sole-owner API basenames; may exist only under src/scoring/ [AUTH: 00 §34A.2, §34A.5].
++++++++RESERVED_SINGLE_OWNER: tuple[str, ...] = ("engine", "crossfit", "roc", "cache", "pooled")
++++++++RESERVED_OWNER_DIR = "scoring"
