+++++++++# Docker build context exclusions.
+++++++++#
+++++++++# ROOT CAUSE OF THE S00-B IMAGE DEFECT: with no .dockerignore, the host repository's macOS
+++++++++# /Apple Silicon .venv entered the build context, and `COPY . .` after `uv sync` overwrote
+++++++++# the Linux .venv the image had just built. Inside the pod that left
+++++++++# /repo/.venv/bin/python -> /opt/homebrew/opt/python@3.13/bin/python3.13, a dangling symlink,
+++++++++# so the project interpreter did not execute and torch was unimportable.
+++++++++#
+++++++++# Host-generated environments and caches must never enter the image. The authoritative
+++++++++# environment is the one `uv sync --frozen` builds INSIDE the image [AUTH: 01 §12].
+++++++++
+++++++++# host virtualenvs — the defect above
+++++++++.venv
+++++++++**/.venv
+++++++++venv
+++++++++**/venv
+++++++++
+++++++++# host tool caches
+++++++++__pycache__
+++++++++**/__pycache__
+++++++++*.py[cod]
+++++++++.pytest_cache
+++++++++**/.pytest_cache
+++++++++.mypy_cache
+++++++++**/.mypy_cache
+++++++++.ruff_cache
+++++++++**/.ruff_cache
+++++++++
+++++++++# host OS noise
+++++++++.DS_Store
+++++++++**/.DS_Store
+++++++++
+++++++++# NOTE: .git is deliberately NOT excluded. The image ships /repo as a real pinned worktree so
+++++++++# scripts/bootstrap_runpod_s00b.sh can run `git rev-parse HEAD`, verify the exact required
+++++++++# commit and enforce the clean-tree gate inside the pod [AUTH: 01 §35(3), §36; plan §8.1].
++++++++diff --git a/.githooks/pre-commit b/.githooks/pre-commit
++++++++new file mode 100755
++++++++index 0000000..01021a4
++++++++--- /dev/null
+++++++++++ b/.githooks/pre-commit
++++++++@@ -0,0 +1,26 @@
+++++++++#!/usr/bin/env bash
+++++++++# Convenience guard only — bypassable with --no-verify [AUTH: 03 §9; plan I9].
+++++++++set -euo pipefail
+++++++++# symbolic-ref works on an unborn branch; rev-parse does not [initial commit case].
+++++++++BRANCH="$(git symbolic-ref --short -q HEAD || echo DETACHED)"
+++++++++if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "experiment-frozen" ]; then
+++++++++  echo "pre-commit: '$BRANCH' is protected; work on stage/<stage-id> [AUTH: 01 §27]" >&2
+++++++++  exit 1
+++++++++fi
+++++++++STAGED="$(git diff --cached --name-only --diff-filter=ACM)"
+++++++++if echo "$STAGED" | grep -E '^reviews/.*\.py$' | grep -qv '/scratch/'; then
+++++++++  echo "pre-commit: importable code under reviews/ outside scratch/ [AUTH: 03 §9]" >&2
+++++++++  exit 1
+++++++++fi
+++++++++PY="$( [ -x .venv/bin/python ] && echo .venv/bin/python || echo python3 )"
+++++++++CHANGED_PY="$(echo "$STAGED" | grep -E '\.py$' || true)"
+++++++++if [ -n "$CHANGED_PY" ]; then
+++++++++  if $PY -c 'import ruff' >/dev/null 2>&1 || $PY -m ruff --version >/dev/null 2>&1; then
+++++++++    # shellcheck disable=SC2086
+++++++++    $PY -m ruff format --check $CHANGED_PY && $PY -m ruff check $CHANGED_PY
+++++++++  else
+++++++++    # A convenience guard must not block a fresh clone that has no toolchain. The
+++++++++    # authority gate is `make preflight` in CI [AUTH: 01 §33; 03 §9].
+++++++++    echo "pre-commit: ruff unavailable, skipping format/lint; run 'make preflight'" >&2
+++++++++  fi
+++++++++fi
