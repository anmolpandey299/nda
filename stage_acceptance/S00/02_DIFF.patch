++++++def main(argv: list[str] | None = None) -> int:
++++++    ap = argparse.ArgumentParser(description=__doc__)
++++++    ap.add_argument("--root", default=".", help="repository root to check")
++++++    ap.add_argument("--json", action="store_true", dest="as_json")
