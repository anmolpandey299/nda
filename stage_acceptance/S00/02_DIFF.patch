+# ------------------------------------------------------------------ workflow
+TARGET_PLATFORM = "linux/amd64"
+
+
+@pytest.fixture(scope="module")
+def build_script(repo_root: Path) -> str:
+    return (repo_root / "scripts" / "build_science_image.sh").read_text(encoding="utf-8")
+
