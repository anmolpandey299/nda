++++++++++    "SCORER_ENGINE",
++++++++++    "ANALYSIS_DRY_RUN",
++++++++++    "CROSSFIT_NEGATIVE_CONTROL",
++++++++++    "CACHE_ASSERTIONS",
++++++++++    "P0_00_COMPUTE_BUDGET",
++++++++++)
++++++++++
