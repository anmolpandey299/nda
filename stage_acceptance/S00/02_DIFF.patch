+++++    def __init__(self, *, cuda_available: bool = True, bf16: bool = True) -> None:
+++++        self._rng = np.random.default_rng(0)
+++++        self.version = type("V", (), {"cuda": "13.0"})()
+++++        self.cuda = type(
+++++            "C",
+++++            (),
+++++            {
