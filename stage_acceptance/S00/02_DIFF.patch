+def test_science_image_installs_only_from_the_frozen_lock(repo_root: Path) -> None:
+    text = (repo_root / "Dockerfile").read_text(encoding="utf-8")
+    science = text.split("AS science\n", 1)[1].split("AS science-sealed", 1)[0]
