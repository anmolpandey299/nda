++
++def hooks_path_warning(root: Path) -> str | None:
++    """I9 is a convenience layer; a mismatch warns, it does not fail [AUTH: 03 §9; 01 §27]."""
++    try:
++        res = subprocess.run(
++            ["git", "-C", str(root), "config", "--get", "core.hooksPath"],
++            capture_output=True,
++            text=True,
++            check=False,
++        )
++    except OSError:  # pragma: no cover
++        return None
